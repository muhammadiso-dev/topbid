generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Kategoriyalar — guruhlar bilan (Chet tillari, Maktab fanlari, Dasturlash...)
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  pool      String // "education" | "it"
  groupName String    @default("") // "Chet tillari", "Dasturlash" va h.k.
  sortOrder Int       @default(0)
  profiles  Profile[]
}

// Reytingdagi profillar
model Profile {
  id          String    @id @default(cuid())
  name        String
  description String
  city        String
  contactUrl  String // Telegram / Instagram / sayt
  imageUrl    String? // logo (/api/media/... yoki URL)
  pool        String // "education" | "it"
  subType     String // education: "center" | "individual"; it: kategoriya guruhi
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  verifyStatus String   @default("none") // "none" | "awaiting" | "pending" | "verified"
  status      String    @default("active") // "pending" (pul kutilmoqda) | "active"
  totalBid    Int       @default(0) // jami reyting summasi (to'liq qiymat)
  lastBidAt   DateTime  @default(now())
  clicks      Int       @default(0)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  editToken   String?
  claimCode   String?
  claimExpiresAt DateTime?
  bids              Bid[]
  reviews           Review[]
  verificationRequests VerificationRequest[]
  viewEvents         ProfileView[]

  @@index([pool, subType, totalBid])
}

// To'lov yozuvlari — haqiqatda to'langan pul (aksiya davrida 50%)
model Bid {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount    Int // so'mda (haqiqiy to'lov — pul tushganda StarKerak tasdiqlaydi)
  credit    Int       @default(0) // reytingga yoziladigan summa
  status    String   @default("awaiting") // "awaiting" (pul kutilmoqda) | "paid" | "refunded"
  createdAt DateTime @default(now())
}

// Bepul sharh/baholar (reytingga ta'sir qilmaydi)
model Review {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessionId  String
  authorName String
  rating     Int // 1..5
  comment    String
  createdAt  DateTime @default(now())

  @@unique([profileId, sessionId])
}

// Sayt statistikasi
model SiteStats {
  id        String   @id @default("main")
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Admin bildirishnomalari (Telegram guruh xabarlari jurnali)
model AdminLog {
  id        String   @id @default(cuid())
  type      String // new_profile | topup | refund | review | verification | verify_approved | verify_rejected | info
  message   String
  profileId String?
  createdAt DateTime @default(now())
}

// Verifikatsiya so'rovlari (pullik "Tekshirilgan" belgisi)
model VerificationRequest {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fee        Int // to'langan summ (aksiya bilan ham real pul)
  status     String    @default("awaiting") // "awaiting" (pul kutilmoqda) | "pending" (hujjat kutilmoqda) | "approved" | "refunded"
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status])
}

// Profil analitikasi — har bir ko'rish/klik geo va qurilma bilan
model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessionId String
  type      String // "view" | "click"
  city      String   @default("")
  country   String   @default("")
  device    String   @default("desktop") // desktop | mobile | tablet
  referrer  String   @default("direct")
  createdAt DateTime @default(now())

  @@index([profileId, type, createdAt])
}

// StarKerak (HumoCardBot) dan kelgan to'lov xabarlari jurnali
model PaymentLog {
  id             String    @id @default(cuid())
  externalId     String? // StarKerak payment id
  amount         Int // so'mda
  cardLast4      String    @default("")
  rawMessage     String    @default("")
  matched        Boolean   @default(false)
  matchedProfileId String?
  matchedBidId   String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([matched])
}

// Sayt sozlamalari (aksiya boshqaruvi) — singleton
model AppSettings {
  id           String   @id @default("main")
  promoActive  Boolean  @default(true)
  promoEndsAt  DateTime
  promoPercent Float    @default(0.5) // 0.5 = 50% chegirma
}
