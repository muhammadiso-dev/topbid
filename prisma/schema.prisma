generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Kategoriyalar — guruhlar bilan (Chet tillari, Maktab fanlari, Dasturlash...)
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  pool      String // "education" | "it"
  groupName String    @default("") // "Chet tillari", "Dasturlash" va h.k.
  sortOrder Int       @default(0)
  profiles  Profile[]
}

// Reytingdagi profillar
model Profile {
  id          String    @id @default(cuid())
  name        String
  description String
  city        String
  contactUrl  String // Telegram / Instagram / sayt
  imageUrl    String? // logo (/api/media/... yoki URL)
  pool        String // "education" | "it"
  subType     String // education: "center" | "individual"; it: kategoriya guruhi
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  verifyStatus String   @default("none") // "none" | "pending" | "verified"
  totalBid    Int       @default(0) // jami reyting summasi (to'liq qiymat)
  lastBidAt   DateTime  @default(now())
  clicks      Int       @default(0)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  bids              Bid[]
  reviews           Review[]
  verificationRequests VerificationRequest[]

  @@index([pool, subType, totalBid])
}

// To'lov yozuvlari — haqiqatda to'langan pul (aksiya davrida 50%)
model Bid {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount    Int // so'mda (haqiqiy to'lov)
  status    String   @default("paid") // "paid" | "refunded"
  createdAt DateTime @default(now())
}

// Bepul sharh/baholar (reytingga ta'sir qilmaydi)
model Review {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessionId  String
  authorName String
  rating     Int // 1..5
  comment    String
  createdAt  DateTime @default(now())

  @@unique([profileId, sessionId])
}

// Sayt statistikasi
model SiteStats {
  id        String   @id @default("main")
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Admin bildirishnomalari (Telegram guruh xabarlari jurnali)
model AdminLog {
  id        String   @id @default(cuid())
  type      String // new_profile | topup | refund | review | verification | verify_approved | verify_rejected | info
  message   String
  profileId String?
  createdAt DateTime @default(now())
}

// Verifikatsiya so'rovlari (pullik "Tekshirilgan" belgisi)
model VerificationRequest {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fee        Int // to'langan summ (aksiya bilan ham real pul)
  status     String    @default("pending") // "pending" | "approved" | "refunded"
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status])
}
