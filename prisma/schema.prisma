generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Kategoriyalar: fan/soha bo'yicha (IELTS, Matematika, Frontend, ...)
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  pool      String    // "education" | "it"
  sortOrder Int       @default(0)
  profiles  Profile[]
}

// Reytingdagi profillar (markaz, repetitor, IT mutaxassis)
model Profile {
  id          String    @id @default(cuid())
  name        String
  description String
  city        String
  contactUrl  String // Telegram / Instagram / sayt
  imageUrl    String? // logo yoki rasm URL
  pool        String // "education" | "it"
  subType     String // education: "center" | "individual"; it: kichik toifa nomi
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  verified    Boolean   @default(false) // "Tekshirilgan" belgisi
  totalBid    Int       @default(0) // jami to'langan summa (so'mda)
  lastBidAt   DateTime  @default(now()) // teng summalarda kim ilgari to'lagan bo'lsa, yuqorida turadi
  clicks      Int       @default(0) // kontakt havolasiga bosilganlar soni
  views       Int       @default(0) // profil sahifasi ko'rilganlar soni
  createdAt   DateTime  @default(now())
  bids        Bid[]
  reviews     Review[]

  @@index([pool, subType, totalBid])
}

// Har bir to'lov yozuvi (auksion taklifi)
model Bid {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount    Int // so'mda
  status    String   @default("paid") // "paid" | "refunded"
  createdAt DateTime @default(now())
}

// Bepul sharh/baholar (reytingga ta'sir qilmaydi)
model Review {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessionId String // bir foydalanuvchi bir profilga bir marta yozishi uchun
  authorName String
  rating    Int // 1..5
  comment   String
  createdAt DateTime @default(now())

  @@unique([profileId, sessionId])
}

// Sayt statistikasi (tashriflar hisoblagichi)
model SiteStats {
  id        String   @id @default("main")
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Admin bildirishnomalari (Telegram xabarlari jurnali)
model AdminLog {
  id        String   @id @default(cuid())
  type      String // "new_profile" | "new_bid" | "topup" | "refund" | "review" | "info"
  message   String
  profileId String?
  createdAt DateTime @default(now())
}
